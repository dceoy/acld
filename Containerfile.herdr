# syntax=docker/dockerfile:1
FROM ghcr.io/dceoy/acld-dev:latest

LABEL \
  org.opencontainers.image.title="acld" \
  org.opencontainers.image.description="Herdr development environment for Apple Container" \
  org.opencontainers.image.source="https://github.com/dceoy/acld" \
  org.opencontainers.image.licenses="MIT"

# hadolint ignore=DL3066
USER root

RUN \
      curl -fsSL https://herdr.dev/install.sh \
        | env HERDR_INSTALL_DIR=/usr/local/bin sh \
      && herdr --version

# hadolint ignore=DL3066
USER ${USER_NAME}
WORKDIR /workspace
